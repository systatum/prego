{
  "name": "systatum",
  "version": "1.0.0",
  "private": true,
  "description": "systatum",
  "author": "Adam Hakarsa",
  "keywords": [
    "gatsby"
  ],
  "scripts": {
    "dev": "tinacms dev -c \"gatsby develop\"",
    "dev-local": "gatsby develop",
    "start": "gatsby develop",
    "build": "tinacms build && gatsby build",
    "build:gatsby": "gatsby build",
    "build:preview": "tinacms build --skip-indexing --skip-cloud-checks && sleep 2 && gatsby build",
    "serve": "gatsby serve",
    "clean": "gatsby clean",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@netlify/functions": "^4.2.1",
    "@remixicon/react": "^4.6.0",
    "@systatum/coneto": "3.0.0",
    "@tinacms/cli": "^1.9.8",
    "framer-motion": "^12.18.1",
    "gatsby": "^5.14.6",
    "gatsby-plugin-postcss": "^6.16.0",
    "gatsby-plugin-styled-components": "^6.16.0",
    "i18next": "^26.0.9",
    "i18next-browser-languagedetector": "^8.2.1",
    "postcss": "^8.5.6",
    "postmark": "^4.0.5",
    "react": "^19",
    "react-dom": "^19",
    "react-hot-toast": "^2.5.2",
    "react-i18next": "^17.0.6",
    "react-player": "^2.16.0",
    "rss": "^1.2.2",
    "tinacms": "^2.7.8",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@types/node": "^20.19.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/rss": "^0.0.32",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.3.3"
  }
}
