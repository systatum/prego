{
  "name": "prego-repo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:workaty": "turbo run build --filter=workaty-homepage",
    "build:systatum": "turbo run build --filter=systatum",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@headlessui/react": "^2.2.4",
    "@hookform/resolvers": "^5.0.1",
    "@netlify/functions": "^4.2.1",
    "@radix-ui/react-slot": "^1.2.3",
    "@remixicon/react": "^4.6.0",
    "@systatum/coneto": "3.0.0",
    "@tailwindcss/postcss": "^4",
    "@tinacms/cli": "^1.9.8",
    "@types/node": "^24.0.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "eslint": "^9",
    "framer-motion": "^12.18.1",
    "gatsby": "^5.14.6",
    "libphonenumber-js": "^1.12.10",
    "lucide-react": "^0.484.0",
    "mermaid": "^11.6.0",
    "motion": "^12.15.0",
    "postcss-selector-namespace": "^3.0.1",
    "postmark": "^4.0.5",
    "prettier": "^3.5.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.62.0",
    "react-hot-toast": "^2.5.2",
    "react-icons": "^5.5.0",
    "react-player": "^2.16.0",
    "react-use-measure": "^2.1.7",
    "rss": "^1.2.2",
    "shiki": "^3.4.2",
    "styled-components": "^6.1.19",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^4",
    "tinacms": "^2.7.8",
    "turbo": "^2.5.4",
    "tw-animate-css": "^1.3.6",
    "typescript": "5.8.2",
    "usehooks-ts": "^3.1.1",
    "zod": "^3.24.4",
    "zustand": "^5.0.5"
