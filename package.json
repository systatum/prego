{
  "name": "prego-repo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:workaty": "turbo run build --filter=workaty-homepage",
    "build:systatum": "turbo run build --filter=systatum",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@netlify/plugin-nextjs": "^5.11.6",
    "framer-motion": "^12.18.1",
    "next-themes": "^0.4.6",
    "@headlessui/react": "^2.2.4",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-dialog": "^1.1.14",
    "@tinacms/cli": "^1.9.8",
    "@types/node": "^24.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "lucide-react": "^0.484.0",
    "mermaid": "^11.6.0",
    "motion": "^12.15.0",
    "next": "15.3.0",
    "prettier": "^3.5.3",
    "react": "^19.1.0",
    "react-icons": "^5.5.0",
    "react-use-measure": "^2.1.7",
    "shiki": "^3.4.2",
    "tailwind-merge": "^2.6.0",
    "tinacms": "^2.7.8",
    "turbo": "^2.5.4",
    "typescript": "5.8.2",
    "usehooks-ts": "^3.1.1"
  }
}
